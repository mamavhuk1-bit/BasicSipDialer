<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Status & Account Toggle Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#33000000"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Status: Not Registered"
                android:textColor="#FF5252"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnToggleAccount"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="#37474F"
                android:text="Account"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Collapsible SIP Login Card -->
        <LinearLayout
            android:id="@+id/layoutLoginCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#26FFFFFF"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SIP Account Settings"
                android:textColor="#80DEEA"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Username / Extension"
                android:inputType="text"
                android:textColor="#FFFFFF"
                android:textColorHint="#B0BEC5" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Password"
                android:inputType="textPassword"
                android:textColor="#FFFFFF"
                android:textColorHint="#B0BEC5" />

            <EditText
                android:id="@+id/etDomain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Domain / Server IP"
                android:inputType="textUri"
                android:textColor="#FFFFFF"
                android:textColorHint="#B0BEC5" />

            <Spinner
                android:id="@+id/spinnerTransport"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="4dp"
                android:backgroundTint="#FFFFFF" />

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#00B0FF"
                android:text="Save &amp; Connect"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Number Display & Backspace -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="#26000000"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp">

            <EditText
                android:id="@+id/etDialNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:hint="Enter Number"
                android:inputType="phone"
                android:textColor="#FFFFFF"
                android:textColorHint="#78909C"
                android:textSize="26sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnBackspace"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:backgroundTint="#37474F"
                android:text="⌫"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Unique Circular Dialpad Grid -->
        <GridLayout
            android:id="@+id/dialpadGrid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="14dp"
            android:columnCount="3"
            android:rowCount="4">

            <Button android:id="@+id/btn1" android:layout_width="74dp" android:layout_height="74dp" android:layout_margin="8dp" android:background="@drawable/bg_dial_btn" android:text="1" android:textColor="#FFFFFF" android:textSize="24sp" />
            <Button android:id="@+id/btn2" android:layout_width="74dp" android:layout_height="74dp" android:layout_margin="8dp" android:background="@drawable/bg_dial_btn" android:text="2" android:textColor="#FFFFFF" android:textSize="24sp" />
            <Button android:id="@+id/btn3" android:layout_width="74dp" android:layout_height="74dp" android:layout_margin="8dp" android:background="@drawable/bg_dial_btn" android:text="3" android:textColor="#FFFFFF" android:textSize="24sp" />

            <Button android:id="@+id/btn4" android:layout_width="74dp" android:layout_height="74dp" android:layout_margin="8dp" android:background="@drawable/bg_dial_btn" android:text="4" android:textColor="#FFFFFF" android:textSize="24sp" />
            <Button android:id="@+id/btn5" android:layout_width="74dp" android:layout_height="74dp" android:layout_margin="8dp" android:background="@drawable/bg_dial_btn" android:text="5" android:textColor="#FFFFFF" android:textSize="24sp" />
            <Button android:id="@+id/btn6" android:layout_width="74dp" android:layout_height="74dp" android:layout_margin="8dp" android:background="@drawable/bg_dial_btn" android:text="6" android:textColor="#FFFFFF" android:textSize="24sp" />

            <Button android:id="@+id/btn7" android:layout_width="74dp" android:layout_height="74dp" android:layout_margin="8dp" android:background="@drawable/bg_dial_btn" android:text="7" android:textColor="#FFFFFF" android:textSize="24sp" />
            <Button android:id="@+id/btn8" android:layout_width="74dp" android:layout_height="74dp" android:layout_margin="8dp" android:background="@drawable/bg_dial_btn" android:text="8" android:textColor="#FFFFFF" android:textSize="24sp" />
            <Button android:id="@+id/btn9" android:layout_width="74dp" android:layout_height="74dp" android:layout_margin="8dp" android:background="@drawable/bg_dial_btn" android:text="9" android:textColor="#FFFFFF" android:textSize="24sp" />

            <Button android:id="@+id/btnStar" android:layout_width="74dp" android:layout_height="74dp" android:layout_margin="8dp" android:background="@drawable/bg_dial_btn" android:text="*" android:textColor="#80DEEA" android:textSize="24sp" />
            <Button android:id="@+id/btn0" android:layout_width="74dp" android:layout_height="74dp" android:layout_margin="8dp" android:background="@drawable/bg_dial_btn" android:text="0" android:textColor="#FFFFFF" android:textSize="24sp" />
            <Button android:id="@+id/btnHash" android:layout_width="74dp" android:layout_height="74dp" android:layout_margin="8dp" android:background="@drawable/bg_dial_btn" android:text="#" android:textColor="#80DEEA" android:textSize="24sp" />
        </GridLayout>

        <!-- Contacts & Call Action Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnContacts"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="#455A64"
                android:text="Contacts"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCall"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1.5"
                android:backgroundTint="#00C853"
                android:text="CALL"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- In-Call Controls Panel -->
        <LinearLayout
            android:id="@+id/layoutInCall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#CC102027"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvCallState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Calling..."
                android:textColor="#69F0AE"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnMute"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="#37474F"
                    android:text="Mute"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnSpeaker"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="#37474F"
                    android:text="Speaker"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnRecord"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="#37474F"
                    android:text="Record"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnHangup"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#D50000"
                android:text="END CALL"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
